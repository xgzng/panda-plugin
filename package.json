{
  "name": "panda-company-plugin",
  "version": "4.9.0",
  "description": "Company AI coding guardrails based on Ponytail.",
  "keywords": ["opencode-plugin", "opencode", "panda", "ponytail", "pi-package", "skills", "qoder"],
  "license": "MIT",
  "author": {
    "name": "Company Engineering, based on Dietrich Gebert's Ponytail",
    "url": "https://github.com/DietrichGebert"
  },
  "homepage": "https://github.com/DietrichGebert/ponytail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DietrichGebert/ponytail.git"
  },
  "bugs": {
    "url": "https://github.com/DietrichGebert/ponytail/issues"
  },
  "main": "./.opencode/plugins/ponytail.mjs",
  "exports": {
    ".": "./.opencode/plugins/ponytail.mjs",
    "./plugin": "./.opencode/plugins/ponytail.mjs"
  },
  "files": [
    "AGENTS.md",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/",
    "scripts/uninstall.js",
    "rules/",
    "THIRD_PARTY_NOTICES.md",
    "assets/",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --prefix pi-extension && npm test --prefix ponytail-mcp"
  },
  "pi": {
    "extensions": ["./pi-extension/index.js"],
    "skills": ["./skills"]
  },
  "private": true
}

